# Google AI Studio / Gemini API key (never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Use LangChain for Gemini calls (default true). Set false to use native google-generativeai only.
# USE_LANGCHAIN=true

# Optional: override default model (gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
